# Development environment variables
# Copy this file to .env.local for local overrides (not committed to git)

# App environment identifier
EXPO_PUBLIC_APP_ENV=development

# API base URL
EXPO_PUBLIC_API_URL=https://kilnkins.onrender.com

# API auth stuff
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=431375939143-o15ljs20t1iviq6m8tmarf1q5tkoet2r.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=431375939143-e0puarac123gua0cbuph6ouq5s55nkdn.apps.googleusercontent.com

# Feature flags
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false
# Set to true to unlock all Premium gates without RevenueCat (quick demos).
# Use Account Settings → Premium testing (dev) to toggle free/premium when false.
EXPO_PUBLIC_FORCE_PREMIUM=false

# PostHog (optional in dev — set key to test telemetry locally)
EXPO_PUBLIC_POSTHOG_API_KEY=
