# Production environment variables
# DO NOT commit secrets to this file — use EAS Secrets for API keys.
# See: https://docs.expo.dev/build-reference/variables/#using-secrets-in-environment-variables

# App environment identifier
EXPO_PUBLIC_APP_ENV=production

# API base URL — replace with your real production URL
EXPO_PUBLIC_API_URL=https://api.pottery-life.app

# Feature flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true

# RevenueCat
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
