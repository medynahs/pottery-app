# Production environment variables
# DO NOT commit secrets to this file — use EAS Secrets for API keys.
# See: https://docs.expo.dev/build-reference/variables/#using-secrets-in-environment-variables

# App environment identifier
EXPO_PUBLIC_APP_ENV=production

# API base URL — replace with your real production URL
EXPO_PUBLIC_API_URL=https://api.pottery-life.app

# API auth stuff
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=431375939143-o15ljs20t1iviq6m8tmarf1q5tkoet2r.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=431375939143-e0puarac123gua0cbuph6ouq5s55nkdn.apps.googleusercontent.com

# Feature flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true

# RevenueCat
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
